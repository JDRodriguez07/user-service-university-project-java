# Copy this file to .env and replace every placeholder locally.
# Never commit the resulting .env file.

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_NAME=user-microservice-db
DB_USERNAME=user_service_user
DB_PASSWORD=replace-with-a-strong-database-password

# JWT (Base64-encoded secret with at least 256 bits for HS256)
JWT_SECRET=replace-with-a-secure-base64-encoded-secret
JWT_EXPIRATION_MS=86400000

# Optional bootstrap administrator. Leave disabled for normal startup.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
